# managed cloud backend, read by the account service process (apps/dashboard) when DUSK_MANAGED=1.
# names only: real values live in the account service's production env, never in this repo.
# a service whose public URL is not http on localhost refuses to start without every "required" name below.

# required
DUSK_MANAGED=
INSTABOX_API_KEY=
DUSK_CLOUD_SEAL_KEY=
DUSK_ENTITLEMENT_SIGNING_KEY=
DUSK_MANAGED_PUBLIC_DOMAIN=
# 32+ characters, same value as the edge Worker's EDGE_TOKEN secret
DUSK_MANAGED_EDGE_TOKEN=
DUSK_MANAGED_HOME_PACKAGE_URL=
DUSK_MANAGED_HOME_PACKAGE_SHA256=
DUSK_MANAGED_HOME_PACKAGE_SIGNATURE=

# optional: package and release sources
DUSK_MANAGED_HOME_PACKAGE_FILE=
DUSK_MANAGED_HOME_PACKAGE_SIGNATURE_FILE=
DUSK_MANAGED_HOME_RELEASE_FILE=
DUSK_RELEASE_PUBLIC_KEYS=
DUSK_UPDATE_POLICY_FILE=

# optional: provider
INSTABOX_BASE_URL=
DUSK_MANAGED_PROVIDER_PLAN=
DUSK_MANAGED_PROVIDER_TEMPLATE=
DUSK_MANAGED_IDLE_PAUSE_MINUTES=
DUSK_MANAGED_KINDS=
DUSK_MANAGED_SCOPE=

# optional: backups (the backup key defaults to one derived from DUSK_CLOUD_SEAL_KEY)
DUSK_MANAGED_BACKUP_KEY=
DUSK_MANAGED_BACKUP_KEY_PREVIOUS=
DUSK_MANAGED_BACKUP_DIR=
DUSK_MANAGED_BACKUP_HOURS=
DUSK_MANAGED_BACKUP_KEEP=
DUSK_MANAGED_BACKUP_MAX_MB=
# skip backups rather than leave less than this many GiB free on the backup disk (default 20)
DUSK_MANAGED_BACKUP_MIN_FREE_GB=
DUSK_MANAGED_BACKUP_TAIL_DAYS=

# optional: lifecycle tuning
DUSK_MANAGED_RETENTION_DAYS=
DUSK_MANAGED_DELETE_DELAY_DAYS=
DUSK_MANAGED_IDLE_MINUTES=
DUSK_MANAGED_LEASE_HOURS=
DUSK_MANAGED_WAKE_LEAD_MINUTES=
DUSK_MANAGED_EDGE_WAKES_PER_HOUR=
DUSK_MANAGED_LOST_AFTER_MINUTES=


# edge Worker (edge/wrangler.jsonc): ROUTE_URL and PUBLIC_DOMAIN are vars there;
# EDGE_TOKEN and HOOK_SEAL_KEY (32+ characters) are set with `wrangler secret put`, never here.
